{
    "name": "@playfast/tsagent",
    "version": "0.1.1",
    "license": "Apache-2.0",
    "description": "Agent-oriented TypeScript language service CLI: symbol maps, find-refs, rename, dead code, type intelligence, diagrams, speculative checks, and a session daemon — built on the native TypeScript compiler port (typescript-go).",
    "keywords": [
        "TypeScript",
        "agent",
        "language-service",
        "cli",
        "refactoring",
        "tsagent"
    ],
    "homepage": "https://github.com/shmuelhizmi/typescript-go-effect/tree/tsagent/cmd/tsagent",
    "bugs": {
        "url": "https://github.com/shmuelhizmi/typescript-go-effect/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/shmuelhizmi/typescript-go-effect.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "preferUnplugged": true,
    "engines": {
        "node": ">=18"
    },
    "files": [
        "bin",
        "lib",
        "README.md"
    ],
    "bin": {
        "tsagent": "./bin/tsagent.js"
    },
    "optionalDependencies": {
        "@playfast/tsagent-darwin-arm64": "0.1.1",
        "@playfast/tsagent-darwin-x64": "0.1.1",
        "@playfast/tsagent-linux-arm64": "0.1.1",
        "@playfast/tsagent-linux-x64": "0.1.1",
        "@playfast/tsagent-win32-arm64": "0.1.1",
        "@playfast/tsagent-win32-x64": "0.1.1"
    }
}
