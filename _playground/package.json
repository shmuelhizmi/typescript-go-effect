{
    "name": "effectscript-playground",
    "private": true,
    "type": "module",
    "scripts": {
        "build:tsgo": "go build -o node_modules/.cache/tsgo-bin/tsgo ../cmd/tsgo",
        "build:wasm": "node scripts/build-wasm.mjs",
        "prepare:assets": "node scripts/build-types-pack.mjs && node scripts/build-effect-vendor.mjs",
        "predev": "npm run build:tsgo && npm run build:wasm && npm run prepare:assets",
        "dev": "vite",
        "prebuild": "npm run build:tsgo && npm run build:wasm && npm run prepare:assets",
        "build": "vite build",
        "preview": "vite preview",
        "check": "npm run build:tsgo && node_modules/.cache/tsgo-bin/tsgo -p tsconfig.app.json --noEmit",
        "test": "vitest run",
        "smoke": "node smoke/smoke.mjs"
    },
    "dependencies": {
        "@effect-atom/atom": "^0.5.3",
        "@effect-atom/atom-react": "^0.5.0",
        "effect": "^3.21.3",
        "monaco-editor": "^0.55.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "esbuild": "^0.28.0",
        "playwright-core": "^1.60.0",
        "vite": "^8.0.16",
        "vitest": "^4.1.8"
    }
}
